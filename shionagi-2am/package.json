{
  "name": "shionagi-2am",
  "version": "0.1.0",
  "private": true,
  "description": "汐凪市 午前2時 — short third-person survival horror (web, TypeScript, Three.js)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e:smoke": "node e2e/smoke.mjs ../_data/shionagi-2am/smoke",
    "e2e:normal": "node e2e/playthrough.mjs normal ../_data/shionagi-2am/play-normal",
    "e2e:pacifist": "node e2e/playthrough.mjs pacifist ../_data/shionagi-2am/play-pacifist",
    "e2e:audio": "node e2e/audiolab.mjs ../_data/shionagi-2am/audio mix"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/three": "0.187.0",
    "eslint": "^9.18.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
