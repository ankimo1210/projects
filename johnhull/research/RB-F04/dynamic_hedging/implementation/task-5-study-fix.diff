+class CalendarField:
+    def evaluate(self, time, spots):
+        spots = np.asarray(spots, float)
+        unsupported = (time == 0) & (spots != 100)
+        return {
+            "variance": np.where(unsupported, np.nan, 0.04 + 0.24 * time),
+            "status": np.where(unsupported, "unsupported_initial", "ok"),
+        }
+
